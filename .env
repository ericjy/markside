# Committed configuration only. No secrets here; put secrets in .env.local (git-ignored).
PLASMO_BROWSER=chrome
PLASMO_PUBLIC_SNAPSHOT_ORIGIN=https://markside.app

# Localhost Review is paused. Set to true (and see lib/localhost-review-entry.tsx) to build it.
PLASMO_PUBLIC_LOCALHOST_REVIEW=false

# Readability Check is unreleased. Set to true in .env.local to build it.
PLASMO_PUBLIC_READABILITY_CHECK=false
